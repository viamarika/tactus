---
import PageLayout from "@layouts/page.astro";
import { getCollection } from "astro:content";

export const songs = await getCollection("songs");
---

<PageLayout>
	<div slot="outer">
		<h2>
			round <span id="round"/>
		</h2>
		<p>
			feel the <span id="type"/>
		</p>
	</div>

	<!-- {songs.slice(2).map((song) => <li><button -->
	<!-- class="hover:(bg-brand-hover text-white)  focus:(bg-brand-hover text-white outline-0) block w-full text-align-left p-1"> -->
	<!-- {song.data.title} -->
	<!-- </button> -->
	<!-- </li> -->
	<!-- )} -->

	<input
		slot="checkbox"
		class="appearance-none cursor-pointer i-tactus:play checked:(i-tactus-pause size-10 translate-x-0) size-10 translate-x-1"
		type="checkbox"
	>
</PageLayout>

<script>
	import { atom, computed, effect } from "nanostores";

	const shuffle = (songs: Song[]) => {
		let len = songs.length;

		let t: Song;
		let i: number = Infinity;

		while (len) {
			i = Math.floor(Math.random() * len--);
			t = songs[len];
			songs[len] = songs[i];
			songs[i] = t;
		}

		return songs;
	};

	type Song = {
		id: string;
		path: string;
		title: string;
		type: "melody" | "beat";
		current: boolean;
	};

	const songs = atom<Song[]>(
		shuffle([
			{
				id: crypto.randomUUID(),
				type: "beat",
				title: "We will rock you - Queen",
				path: "/miua",
				current: false,
			},
			{
				id: crypto.randomUUID(),
				type: "melody",
				title: "We wish you a merry christmas",
				path: "/miua",
				current: false,
			},
			{
				id: crypto.randomUUID(),
				type: "beat",
				title: "Billie jean - Michael Jackson",
				path: "/miua",
				current: false,
			},
			{
				id: crypto.randomUUID(),
				type: "beat",
				title: "ABC - Jacksons 5",
				path: "/miua",
				current: false,
			},
			{
				id: crypto.randomUUID(),
				type: "beat",
				title: "We will rock you - Queen",
				path: "/miua",
				current: false,
			},
		]),
	);

	songs.set([...songs.get(), songs.get()[0]]);

	const selectedSongs = computed(songs, (songs) => {
		return shuffle(songs.slice(0, 3));
	});

	const round = atom(1);
	const currentSong = computed([songs, round], (s, r) => s[r]);

	effect([round, currentSong], (round, song) => {
		const roundDisplay = document.getElementById("round");
		const songTypeDisplay = document.getElementById("type");

		if (roundDisplay && songTypeDisplay) {
			roundDisplay.append(document.createTextNode(String(round)));
			songTypeDisplay.append(document.createTextNode(song.type));
		}
	});

	effect(selectedSongs, (songs) => {
		const screen = document.getElementById("screen");

		if (screen) {
			songs.forEach((song) => {
				const songListItem = screen.appendChild(document.createElement("li"));
				songListItem.appendChild(document.createTextNode(song.title));
			});
		}
	});
</script>
